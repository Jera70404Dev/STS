# ===== Base de datos PostgreSQL (Neon, plan gratuito) =====
# Connection string con pooling: neon://... o postgresql://...
# Lo encuentras en tu proyecto de Neon (console.neon.tech)
DATABASE_URL=

# ===== Email (Resend, plan gratuito 100 emails/dia) =====
# API key: https://resend.com/api-keys
RESEND_API_KEY=
# Remitente: dominio verificado en Resend (tras agregar DNS SPF/DKIM).
# Antes de verificar el dominio usa: Onboarding <onboarding@resend.dev>
RESEND_FROM=
# Correo del jefe que recibe la notificacion de cada reserva
ADMIN_NOTIFY_EMAIL=

# ===== Seguridad (Admin panel) =====
# Usa un valor largo y aleatorio. Ej: openssl rand -base64 32
JWT_SECRET=
# Credenciales del admin (se cargan con: npm run db:seed)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== Opcional =====
# Origin permitido por CORS (para desarrollo en otro puerto)
# CORS_ORIGIN=http://localhost:5173




