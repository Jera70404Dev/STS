{
  "name": "transport-agency",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de reservas para agencia de transporte (frontend React + API Express en Vercel + PostgreSQL en Neon + emails con Resend)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:front\"",
    "dev:api": "tsx watch api/index.ts",
    "dev:front": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "tsx api/index.ts",
    "typecheck": "tsc --noEmit && npm --prefix frontend run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "resend": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
